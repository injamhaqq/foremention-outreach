# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Password to log in to the Foremention Outreach UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./linki.db in cwd)
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during LinkedIn automation (useful for debugging)
HEADLESS=true

# SMTP/IMAP TLS certificates are verified by default. Keep this false in
# production. Set true only for a deliberately trusted self-signed internal
# mail server after you have verified the certificate out of band.
EMAIL_ALLOW_INSECURE_TLS=false

# ── Foremention Customer Hunter ───────────────────────────────────────────────
# Private service-to-service mini-audit boundary. The same secret must be configured
# in the main Foremention deployment. Never expose this token in browser-side code.
FOREMENTION_OUTREACH_URL=https://foremention.com
FOREMENTION_OUTREACH_SECRET=

# Evidence-grounded prospect research + cold email/LinkedIn drafting.
# If no AI provider is configured, assisted mode falls back to deterministic,
# evidence-only first-touch drafts; Foremention mini-audits remain unavailable.
# Supported presets: groq, openrouter, openai. Any OpenAI-compatible endpoint can be
# configured by setting HUNTER_AI_BASE_URL, HUNTER_AI_API_KEY and HUNTER_AI_MODEL.
HUNTER_AI_PROVIDER=groq
HUNTER_AI_BASE_URL=https://api.groq.com/openai/v1
HUNTER_AI_API_KEY=
HUNTER_AI_MODEL=
# GROQ_API_KEY and GROQ_MODEL may be used instead when provider=groq.
GROQ_API_KEY=
GROQ_MODEL=
# Optional alternatives.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Fully local/no-provider-fee AI option. Ollama exposes an OpenAI-compatible
# /v1/chat/completions endpoint; local deployments do not require a real API key.
# Set HUNTER_AI_PROVIDER=ollama and choose any locally pulled model.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=

# Customer Hunter maintenance loop: signal expiry/scoring, reply routing, durable
# suppressions, and opportunity promotion. Minimum accepted value is 30000 ms.
HUNTER_RUNNER_INTERVAL_MS=120000


# ── Customer Hunter 24/7 acquisition ─────────────────────────────────────────
# Discovery runs on its own cadence inside the Customer Hunter runner. Search
# providers are adapters; configure one or both. SearXNG can be self-hosted.
HUNTER_DISCOVERY_ENABLED=true
HUNTER_DISCOVERY_INTERVAL_MS=21600000
HUNTER_DISCOVERY_LIMIT_PER_QUERY=25
HUNTER_MAX_COMPANIES_PER_CYCLE=50
HUNTER_MAX_BUYERS_PER_COMPANY=3
# Semicolon-separated search queries. Leave blank to use the built-in B2B SaaS
# AI-search/SEO/GEO/AEO query set.
HUNTER_DISCOVERY_QUERIES=

SEARXNG_URL=
# Firecrawl Cloud (api.firecrawl.dev) requires FIRECRAWL_API_KEY. A self-hosted
# Firecrawl URL may run without a key depending on that deployment's auth settings.
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=

# Optional self-hosted crawler used for deeper company-page enrichment.
CRAWL4AI_URL=
# Crawl4AI 0.9+ Docker is secure-by-default; set the same bearer token on the service.
CRAWL4AI_API_TOKEN=
HUNTER_AUTO_CRAWL_COMPANY=true

# Buyer/contact waterfall. Paid providers are attempted first when configured;
# SearXNG is the zero-fee LinkedIn-profile fallback and never fabricates email.
HUNTER_BUYER_PROVIDER_ORDER=hunter,apollo,prospeo,searxng
HUNTER_API_KEY=
APOLLO_API_KEY=
PROSPEO_API_KEY=

# Autonomy modes: manual | assisted | guarded_auto | full_auto.
# assisted is the safe launch default: generate evidence-backed first touches,
# but require approval. guarded_auto/full_auto still honor suppression, evidence,
# channel-health, account-limit and reply-stop gates.
HUNTER_AUTOPILOT_MODE=assisted
# Existing Linki run used for enrollment once a prospect is approved/auto-started.
HUNTER_DEFAULT_RUN_ID=


# ── Assisted production canary ────────────────────────────────────────────────
# Disabled by default. When enabled, POST /api/hunter/canary with
# {"confirmation":"RUN_ASSISTED_CANARY"}. The route hard-forces assisted mode,
# one discovery query, <=5 search results, <=2 companies, <=2 buyers/company,
# and never auto-sends first touches. Full readiness must pass first.
HUNTER_CANARY_ENABLED=false
# Optional narrow query for the canary. If blank, the first configured Hunter
# discovery query is used; if none exists, a built-in AI-search hiring query is used.
HUNTER_CANARY_QUERY=

# Production persistence gate. On Railway, Customer Hunter automatically proves
# persistence only after the same SQLite state survives a deployment-ID change.
# Leave this unset on Railway. For another production host with a verified
# persistent mount, an operator may explicitly set this to true.
HUNTER_PERSISTENT_STORAGE_CONFIRMED=

# ── Optional SQLite disaster recovery (Litestream → Cloudflare R2/S3) ─────────
# Used only when the Docker Compose "backup" profile is enabled.
# Cloudflare R2 uses region=auto; endpoint format:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_PATH=foremention-outreach
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_ACCESS_KEY_ID=
LITESTREAM_S3_SECRET_ACCESS_KEY=

