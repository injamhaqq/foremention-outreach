# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Password to log in to the Foremention Outreach UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./linki.db in cwd)
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during LinkedIn automation (useful for debugging)
HEADLESS=true

# ── Foremention Customer Hunter ───────────────────────────────────────────────
# Private service-to-service mini-audit boundary. The same secret must be configured
# in the main Foremention deployment. Never expose this token in browser-side code.
FOREMENTION_OUTREACH_URL=https://foremention.com
FOREMENTION_OUTREACH_SECRET=

# Evidence-grounded prospect research + cold email/LinkedIn drafting.
# Supported presets: groq, openrouter, openai. Any OpenAI-compatible endpoint can be
# configured by setting HUNTER_AI_BASE_URL, HUNTER_AI_API_KEY and HUNTER_AI_MODEL.
HUNTER_AI_PROVIDER=groq
HUNTER_AI_BASE_URL=https://api.groq.com/openai/v1
HUNTER_AI_API_KEY=
HUNTER_AI_MODEL=
# GROQ_API_KEY and GROQ_MODEL may be used instead when provider=groq.
GROQ_API_KEY=
GROQ_MODEL=
# Optional alternatives.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Customer Hunter maintenance loop: signal expiry/scoring, reply routing, durable
# suppressions, and opportunity promotion. Minimum accepted value is 30000 ms.
HUNTER_RUNNER_INTERVAL_MS=120000
